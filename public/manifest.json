{
    "name": "Owl Soundboard",
    "version": "1.0.6",
    "manifest_version": 1,
    "icon": "/iconExtension.png",
    "author": "Olivier Poirier",
    "background_url": "/?background=1",
    "action": {
      "title": "Owl Soundboard",
      "icon": "/icon.png",
      "popover": "/",
      "height": 650,
      "width": 425
    },
    "permissions": [
      {
        "name": "autoplay",
        "reason": "Play synchronized room audio for every participant, including while the soundboard panel is closed."
      }
    ]
}
  
